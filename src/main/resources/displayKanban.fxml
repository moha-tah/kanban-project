<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>

<StackPane xmlns="http://javafx.com/javafx/25"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="DisplayKanbanController">

    <!-- CONTENU PRINCIPAL -->
    <VBox spacing="0" style="-fx-background-color: #f0f0f0;">

        <!-- Barre supérieure -->
        <HBox alignment="CENTER_LEFT" spacing="10"
              style="-fx-background-color: white; -fx-padding: 10; -fx-border-color: lightgray; -fx-border-width: 0 0 1 0;">
            <Label style="-fx-font-size: 24; -fx-font-weight: bold; -fx-text-fill: linear-gradient(from 0% 0% to 100% 100%, #ff6b6b, #4ecdc4);" text="K" />
            <Region HBox.hgrow="ALWAYS" />
            <Button style="-fx-background-color: #ffa500; -fx-text-fill: white;" text="Public" />
            <Button style="-fx-background-color: #da70d6; -fx-text-fill: white;" text="Logout" />
            <Button style="-fx-background-color: #32cd32; -fx-text-fill: white;" text="Snapshot" />
            <Label style="-fx-font-size: 16; -fx-padding: 0 5 0 5;" text="📧" />
            <Label style="-fx-font-size: 16; -fx-padding: 0 5 0 5;" text="🔔" />
            <Label style="-fx-font-size: 16; -fx-padding: 0 5 0 5;" text="🏠" />
            <Circle fill="#4CAF50" radius="12" stroke="white" />
        </HBox>

        <!-- Titre du projet -->
        <HBox alignment="CENTER" style="-fx-padding: 10; -fx-background-color: #f0f0f0;">
            <Label style="-fx-font-size: 20; -fx-font-weight: bold; -fx-text-fill: white; -fx-background-color: purple; -fx-padding: 10;" text="PROJECT ALPHA" />
        </HBox>

        <!-- Contenu principal -->
        <HBox spacing="10" style="-fx-padding: 10;">

            <!-- Colonne USERS -->
            <VBox spacing="10"
                  style="-fx-background-color: linear-gradient(to bottom, #43055aff, #9f15a9ff); -fx-padding: 10; -fx-min-width: 150; -fx-max-width: 150;">
                <Label style="-fx-text-fill: white; -fx-font-weight: bold;" text="USERS" />
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Circle fill="lightblue" radius="20" stroke="white" />
                    <VBox>
                        <Label style="-fx-text-fill: white;" text="Jenny" />
                    </VBox>
                </HBox>
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Circle fill="pink" radius="20" stroke="white" />
                    <VBox>
                        <Label style="-fx-text-fill: white;" text="Mina" />
                    </VBox>
                </HBox>
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Circle fill="red" radius="20" stroke="white" />
                    <VBox>
                        <Label style="-fx-text-fill: white;" text="Thomas" />
                    </VBox>
                </HBox>
            </VBox>

            <!-- Colonne To Do -->
            <VBox spacing="10" style="-fx-background-color: #5D8BF4; -fx-padding: 10; -fx-min-width: 250;">
                <HBox alignment="CENTER">
                    <Label style="-fx-font-weight: bold; -fx-text-fill: white;" text="To Do / 3" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Label style="-fx-font-size: 16; -fx-text-fill: white;" text="⋮" />
                </HBox>

                <!-- Tâche 1 -->
                <VBox style="-fx-background-color: white; -fx-padding: 10; -fx-border-color: lightgray; -fx-border-radius: 5;">
                    <HBox alignment="CENTER_RIGHT">
                        <Label accessibleRole="BUTTON"
                               style="-fx-font-size: 16;"
                               text="⋮"
                               onMouseClicked="#onTaskMenuClick"/>
                    </HBox>
                    <Label style="-fx-font-weight: bold;" text="Créer la maquette IHM" />
                    <Label style="-fx-font-size: 12; -fx-text-fill: gray;"
                           text="Finaliser les écrans principaux pour l'application mobile." />
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <Button style="-fx-background-color: #ffa500; -fx-text-fill: white; -fx-font-size: 10;" text="STATUS" />
                        <Region HBox.hgrow="ALWAYS" />
                        <HBox spacing="-5">
                            <Circle fill="lightblue" radius="12" stroke="white" />
                            <Circle fill="pink" radius="12" stroke="white" />
                        </HBox>
                    </HBox>
                </VBox>

                <!-- Tâche 2 -->
                <VBox style="-fx-background-color: white; -fx-padding: 10; -fx-border-color: lightgray; -fx-border-radius: 5;">
                    <HBox alignment="CENTER_RIGHT">
                        <Label accessibleRole="BUTTON"
                               style="-fx-font-size: 16;"
                               text="⋮"
                               onMouseClicked="#onTaskMenuClick"/>
                    </HBox>
                    <Label style="-fx-font-weight: bold;" text="Configurer l'environnement" />
                    <Label style="-fx-font-size: 12; -fx-text-fill: gray;"
                           text="Installer les outils nécessaires (Java, Git, IDE IntelliJ)." />
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <Button style="-fx-background-color: #ffa500; -fx-text-fill: white; -fx-font-size: 10;" text="STATUS" />
                        <Region HBox.hgrow="ALWAYS" />
                        <HBox spacing="-5">
                            <Circle fill="red" radius="12" stroke="white" />
                        </HBox>
                    </HBox>
                </VBox>

                <!-- Tâche 3 -->
                <VBox style="-fx-background-color: white; -fx-padding: 10; -fx-border-color: lightgray; -fx-border-radius: 5;">
                    <HBox alignment="CENTER_RIGHT">
                        <Label accessibleRole="BUTTON"
                               style="-fx-font-size: 16;"
                               text="⋮"
                               onMouseClicked="#onTaskMenuClick"/>
                    </HBox>
                    <Label style="-fx-font-weight: bold;" text="Rédiger spécifications" />
                    <Label style="-fx-font-size: 12; -fx-text-fill: gray;"
                           text="Décrire les flux utilisateur et les cas d'utilisation." />
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <Button style="-fx-background-color: #ffa500; -fx-text-fill: white; -fx-font-size: 10;" text="STATUS" />
                        <Region HBox.hgrow="ALWAYS" />
                        <HBox spacing="-5">
                            <Circle fill="lightblue" radius="12" stroke="white" />
                        </HBox>
                    </HBox>
                </VBox>
            </VBox>

            <!-- Colonne Doing -->
            <VBox spacing="10" style="-fx-background-color: #f06a10ff; -fx-padding: 10; -fx-min-width: 250;">
                <HBox alignment="CENTER">
                    <Label style="-fx-font-weight: bold;" text="Doing / 2" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Label style="-fx-font-size: 16;" text="⋮" />
                </HBox>

                <!-- Tâche 1 -->
                <VBox style="-fx-background-color: white; -fx-padding: 10; -fx-border-color: lightgray; -fx-border-radius: 5;">
                    <HBox alignment="CENTER_RIGHT">
                        <Label accessibleRole="BUTTON"
                               style="-fx-font-size: 16;"
                               text="⋮"
                               onMouseClicked="#onTaskMenuClick"/>
                    </HBox>
                    <Label style="-fx-font-weight: bold;" text="Intégration Figma" />
                    <Label style="-fx-font-size: 12; -fx-text-fill: gray;"
                           text="Importer les composants et styles depuis Figma." />
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <Button style="-fx-background-color: #eb9f13ff; -fx-text-fill: white; -fx-font-size: 10;" text="STATUS" />
                        <Region HBox.hgrow="ALWAYS" />
                        <HBox spacing="-5">
                            <Circle fill="lightblue" radius="12" stroke="white" />
                        </HBox>
                    </HBox>
                </VBox>

                <!-- Tâche 2 -->
                <VBox style="-fx-background-color: white; -fx-padding: 10; -fx-border-color: lightgray; -fx-border-radius: 5;">
                    <HBox alignment="CENTER_RIGHT">
                        <Label accessibleRole="BUTTON"
                               style="-fx-font-size: 16;"
                               text="⋮"
                               onMouseClicked="#onTaskMenuClick"/>
                    </HBox>
                    <Label style="-fx-font-weight: bold;" text="Recherche palette" />
                    <Label style="-fx-font-size: 12; -fx-text-fill: gray;"
                           text="Choisir les couleurs et typographies pour le thème sombre." />
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <Button style="-fx-background-color: #eb9f13ff; -fx-text-fill: white; -fx-font-size: 10;" text="STATUS" />
                        <Region HBox.hgrow="ALWAYS" />
                        <HBox spacing="-5">
                            <Circle fill="pink" radius="12" stroke="white" />
                        </HBox>
                    </HBox>
                </VBox>
            </VBox>

            <!-- Colonne To Review -->
            <VBox spacing="10" style="-fx-background-color: #d60b0bff; -fx-padding: 10; -fx-min-width: 250;">
                <HBox alignment="CENTER">
                    <Label style="-fx-font-weight: bold;" text="To Review / 2" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Label style="-fx-font-size: 16;" text="⋮" />
                </HBox>

                <!-- Tâche 1 -->
                <VBox style="-fx-background-color: white; -fx-padding: 10; -fx-border-color: lightgray; -fx-border-radius: 5;">
                    <HBox alignment="CENTER_RIGHT">
                        <Label accessibleRole="BUTTON"
                               style="-fx-font-size: 16;"
                               text="⋮"
                               onMouseClicked="#onTaskMenuClick"/>
                    </HBox>
                    <Label style="-fx-font-weight: bold;" text="Relire contenu" />
                    <Label style="-fx-font-size: 12; -fx-text-fill: gray;"
                           text="Vérifier la conformité du texte et des labels." />
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <Button style="-fx-background-color: #ffa500; -fx-text-fill: white; -fx-font-size: 10;" text="STATUS" />
                        <Region HBox.hgrow="ALWAYS" />
                        <HBox spacing="-5">
                            <Circle fill="pink" radius="12" stroke="white" />
                        </HBox>
                    </HBox>
                </VBox>

                <!-- Tâche 2 -->
                <VBox style="-fx-background-color: white; -fx-padding: 10; -fx-border-color: lightgray; -fx-border-radius: 5%;">
                    <HBox alignment="CENTER_RIGHT">
                        <Label accessibleRole="BUTTON"
                               style="-fx-font-size: 16;"
                               text="⋮"
                               onMouseClicked="#onTaskMenuClick"/>
                    </HBox>
                    <Label style="-fx-font-weight: bold;" text="Tester l'API backend" />
                    <Label style="-fx-font-size: 12; -fx-text-fill: gray;"
                           text="Vérifier que tous les endpoints fonctionnent correctement." />
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <Button style="-fx-background-color: #ffa500; -fx-text-fill: white; -fx-font-size: 10;" text="STATUS" />
                        <Region HBox.hgrow="ALWAYS" />
                        <HBox spacing="-5">
                            <Circle fill="red" radius="12" stroke="white" />
                        </HBox>
                    </HBox>
                </VBox>
            </VBox>

            <!-- Colonne Done -->
            <VBox spacing="10" style="-fx-background-color: #0ec20eff; -fx-padding: 10; -fx-min-width: 250;">
                <HBox alignment="CENTER">
                    <Label style="-fx-font-weight: bold;" text="Done / 2" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Label style="-fx-font-size: 16;" text="⋮" />
                </HBox>

                <!-- Tâche 1 -->
                <VBox style="-fx-background-color: white; -fx-padding: 10; -fx-border-color: lightgray; -fx-border-radius: 5%;">
                    <HBox alignment="CENTER_RIGHT">
                        <Label accessibleRole="BUTTON"
                               style="-fx-font-size: 16;"
                               text="⋮"
                               onMouseClicked="#onTaskMenuClick"/>
                    </HBox>
                    <Label style="-fx-font-weight: bold;" text="Établir la charte graphique" />
                    <Label style="-fx-font-size: 12; -fx-text-fill: gray;"
                           text="Définir les couleurs, polices et styles pour l'application." />
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <Button style="-fx-background-color:  #ffa500; -fx-text-fill: white; -fx-font-size: 10;" text="STATUS" />
                        <Region HBox.hgrow="ALWAYS" />
                        <HBox spacing="-5">
                            <Circle fill="lightblue" radius="12" stroke="white" />
                            <Circle fill="red" radius="12" stroke="white" />
                        </HBox>
                    </HBox>
                </VBox>

                <!-- Tâche 2 -->
                <VBox style="-fx-background-color: white; -fx-padding: 10; -fx-border-color: lightgray; -fx-border-radius: 5%;">
                    <HBox alignment="CENTER_RIGHT">
                        <Label accessibleRole="BUTTON"
                               style="-fx-font-size: 16;"
                               text="⋮"
                               onMouseClicked="#onTaskMenuClick"/>
                    </HBox>
                    <Label style="-fx-font-weight: bold;" text="Étudier les personas" />
                    <Label style="-fx-font-size: 12; -fx-text-fill: gray;"
                           text="Définir les profils utilisateurs pour le projet." />
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <Button style="-fx-background-color: #ffa500; -fx-text-fill: white; -fx-font-size: 10;" text="STATUS" />
                        <Region HBox.hgrow="ALWAYS" />
                        <HBox spacing="-5">
                            <Circle fill="pink" radius="12" stroke="white" />
                        </HBox>
                    </HBox>
                </VBox>
            </VBox>

            <!-- Bouton pour ajouter une colonne -->
            <VBox alignment="CENTER" style="-fx-padding: 10;">
                <Button style="-fx-background-color: #a9dfc0ff; -fx-min-width: 40px; -fx-min-height: 40px; -fx-max-width: 40px; -fx-max-height: 40px; -fx-background-radius: 50%;" text="+" />
            </VBox>
        </HBox>
    </VBox>

    <!-- POPUP 1 : MENU DE LA TÂCHE -->
    <VBox fx:id="taskMenuPane"
          visible="false"
          spacing="5"
          style="-fx-background-color: #f0f0f0; -fx-padding: 10; -fx-background-radius: 10;"
          StackPane.alignment="CENTER_LEFT">

        <Button text="ADD A USER" onAction="#onMenuAddUser"/>
        <Button text="SEE USERS"  onAction="#onMenuSeeUsers"/>
        <Button text="EDIT TASK"  onAction="#onMenuEditTask"/>
        <Button text="DELETE TASK"/>
        <Button text="COPY TASK"/>
        <Button text="Close" onAction="#onCloseAllPopups"/>
    </VBox>

    <!-- POPUP 2 : DETAIL (SEE USERS / ADD USER / EDIT TASK) -->
    <StackPane fx:id="detailPopup"
               visible="false"
               StackPane.alignment="CENTER">

        <!-- SEE USERS : View & Delete en BOUTONS -->
        <VBox fx:id="seeUsersPane"
              visible="false"
              spacing="8"
              style="-fx-background-color: #ffffffdd; -fx-padding: 15; -fx-background-radius: 20;">
            <Label text="USERS OF THIS TASK" style="-fx-font-weight: bold;"/>

            <HBox spacing="10">
                <Label text="Marie" />
                <Button text="View"/>
                <Button text="Delete"/>
            </HBox>
            <HBox spacing="10">
                <Label text="Thomas" />
                <Button text="View"/>
                <Button text="Delete"/>
            </HBox>
            <HBox spacing="10">
                <Label text="Mina" />
                <Button text="View"/>
                <Button text="Delete"/>
            </HBox>
            <HBox spacing="10">
                <Label text="Jenny" />
                <Button text="View"/>
                <Button text="Delete"/>
            </HBox>

            <Button text="Close" onAction="#onCloseDetail"/>
        </VBox>

        <!-- ADD USER : ADD en bouton -->
        <VBox fx:id="addUsersPane"
              visible="false"
              spacing="8"
              style="-fx-background-color: linear-gradient(to bottom, #b35eff, #ff9f80); -fx-padding: 15; -fx-background-radius: 20;">
            <Label text="CONNECTED USERS" style="-fx-text-fill: white; -fx-font-weight: bold;"/>

            <HBox spacing="10">
                <Label text="Marie" style="-fx-text-fill: white;"/>
                <Button text="ADD"/>
            </HBox>
            <HBox spacing="10">
                <Label text="Thomas" style="-fx-text-fill: white;"/>
                <Button text="ADD"/>
            </HBox>
            <HBox spacing="10">
                <Label text="Mina" style="-fx-text-fill: white;"/>
                <Button text="ADD"/>
            </HBox>
            <HBox spacing="10">
                <Label text="Jenny" style="-fx-text-fill: white;"/>
                <Button text="ADD"/>
            </HBox>

            <Button text="Close" onAction="#onCloseDetail"/>
        </VBox>

        <!-- EDIT TASK : TextField & TextArea éditables -->
        <VBox fx:id="editTaskPane"
              visible="false"
              spacing="10"
              style="-fx-background-color: #ffe0b3; -fx-padding: 15; -fx-background-radius: 20;">
            <Label text="EDIT TASK" style="-fx-font-weight: bold;"/>

            <!-- NAME : texte modifiable -->
            <HBox spacing="5">
                <Label text="NAME"/>
                <TextField fx:id="editNameField"
                           promptText="Entrer le nouveau nom de la tâche"/>
            </HBox>

            <!-- DESCRIPTION : texte à saisir -->
            <HBox spacing="5">
                <Label text="DESCRIPTION"/>
                <TextArea fx:id="editDescField"
                          prefRowCount="3"
                          promptText="Entrer la nouvelle description"/>
            </HBox>

            <HBox spacing="10">
                <Button text="Save" onAction="#onSaveTask"/>
                <Button text="Cancel" onAction="#onCloseDetail"/>
            </HBox>
        </VBox>

    </StackPane>

</StackPane>