<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane fx:id="cardRoot" prefHeight="180" prefWidth="220"
            xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="client.ihmMain.controllers.KanbanCardController"
            style="-fx-background-color: #72e379; -fx-background-radius: 10; -fx-padding: 10;">

    <VBox spacing="5" style="-fx-padding: 0 0 0 10;">
        <Label fx:id="titleLabel" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: black;" text="KANBAN TITLE" />
        <Label fx:id="creatorLabel" style="-fx-text-fill: black;" text="Creator: ..." />
        <Label fx:id="columnsLabel" style="-fx-text-fill: black;" text="Columns: ..." />

        <Label fx:id="visibilityLabel" style="-fx-font-weight: bold; -fx-text-fill: black;" styleClass="badge-public" text="Visibility: ..." />

    </VBox>

    <HBox alignment="BOTTOM_RIGHT" spacing="10"
          AnchorPane.bottomAnchor="10.0" AnchorPane.rightAnchor="10.0">

        <Button fx:id="viewButton" text="Voir Kanban" onAction="#handleView" styleClass="pretty-button"/>
        <Button fx:id="requestButton" text="Demander autorisation" onAction="#requestPermission" visible="false" styleClass="pretty-button"/>
        <Button fx:id="deleteButton" text="🗑" onAction="#handleDelete" styleClass="pretty-button"/>

    </HBox>
</AnchorPane>
