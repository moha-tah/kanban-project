<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>

<HBox spacing="10"
      style="-fx-padding: 10; -fx-background-color: #FFF2CC; -fx-border-color: #E0C657;
             -fx-border-radius: 5; -fx-background-radius: 5;"
      xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="client.ihmMain.controllers.NotificationItemController">

    <children>
        <Label fx:id="requesterLabel" text="User ?" />
        <Label fx:id="kanbanLabel" text="Kanban ?" />

        <Button fx:id="acceptButton" text="Accepter" />
        <Button fx:id="denyButton" text="Refuser" />
    </children>

</HBox>
