<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="client.ihmMain.controllers.LoginController"
            prefWidth="1280" prefHeight="720"
            styleClass="root-dark">

    <HBox spacing="0" AnchorPane.topAnchor="0" AnchorPane.bottomAnchor="0"
          AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0">

        <!-- Panneau gauche : logo -->
        <StackPane prefWidth="600" style="-fx-background-color: #0b0b0b;">
            <ImageView fitWidth="560" preserveRatio="true" pickOnBounds="true">
                <image>
                    <Image url="@k-logo.png"/>
                </image>
            </ImageView>
        </StackPane>

        <!-- Panneau droit : login -->
        <VBox alignment="CENTER" spacing="14" prefWidth="680" styleClass="login-pane">

            <Label text="Login" styleClass="title"/>

            <Label fx:id="errorLabel" text="" visible="false"
                   style="-fx-text-fill: red; -fx-font-size: 14px;"/>

            <TextField fx:id="usernameField" promptText="Username" styleClass="input" maxWidth="420"/>
            <PasswordField fx:id="passwordField" promptText="Password" styleClass="input" maxWidth="420"/>

            <HBox spacing="10" alignment="CENTER">
                <VBox alignment="CENTER">
                    <Label text="IP Address" styleClass="label-orange"/>
                    <TextField fx:id="ipField" promptText="127.0.0.1" styleClass="input-small" maxWidth="160"/>
                </VBox>
                <VBox alignment="CENTER">
                    <Label text="Port" styleClass="label-orange"/>
                    <TextField fx:id="portField" promptText="5050" styleClass="input-small" maxWidth="160"/>
                </VBox>
            </HBox>

            <Button text="Login" onAction="#onLogin" styleClass="primary-btn" maxWidth="200"/>

            <HBox alignment="CENTER" spacing="6">
                <Label text="Don't have an account?" styleClass="text-small"/>
                <Hyperlink text="Sign up" onAction="#onGoToSignup" styleClass="link"/>
            </HBox>
        </VBox>
    </HBox>
</AnchorPane>