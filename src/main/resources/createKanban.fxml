<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.paint.Color?>
<?import javafx.scene.text.*?>

<AnchorPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="client.ihmMain.controllers.CreateKanbanController"
            prefWidth="900" prefHeight="600"
            style="-fx-background-color: linear-gradient(to bottom right, #6A11CB, #2575FC);">

    <VBox spacing="20" alignment="CENTER" AnchorPane.topAnchor="0" AnchorPane.bottomAnchor="0"
          AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0">

        <!-- Carte centrale -->
        <VBox spacing="15" alignment="CENTER" prefWidth="340"
              style="-fx-background-color: white; -fx-background-radius: 20; -fx-padding: 40; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.15), 10, 0, 0, 4);">

            <!-- Titre -->
            <Label text="✨ Create a new Kanban" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #333;" />
            <Label text="Configure your collaborative workspace."
                   style="-fx-font-size: 13px; -fx-text-fill: #777;" />

            <!-- Info bulle -->
            <HBox alignment="CENTER_LEFT" spacing="8" style="-fx-background-color: #eef4ff; -fx-background-radius: 8; -fx-padding: 8;">
                <ImageView fitHeight="18" fitWidth="18"/>
                <Label text="A kanban allows you to organize your tasks and collaborate effectively with your team."
                       wrapText="true"
                       style="-fx-font-size: 12px; -fx-text-fill: #3A56D0;" />
            </HBox>

            <!-- Champs principaux -->
            <VBox spacing="10" alignment="CENTER_LEFT" prefWidth="380">

                <Label text="Project Name" style="-fx-font-weight: bold; -fx-font-size: 13px;" />
                <TextField fx:id="projectNameField" promptText="Ex: Marketing Sprint"
                           style="-fx-background-radius: 8; -fx-border-color: #ccc; -fx-border-radius: 8; -fx-padding: 8;" />

                <Label text="Description" style="-fx-font-weight: bold; -fx-font-size: 13px;" />
                <TextArea fx:id="descriptionField" promptText="Briefly describe your project..."
                          prefRowCount="3"
                          style="-fx-background-radius: 8; -fx-border-color: #ccc; -fx-border-radius: 8; -fx-padding: 8;" />

                <Label text="Columns" style="-fx-font-weight: bold; -fx-font-size: 13px;" />

                <!-- Liste dynamique de colonnes -->
                <VBox fx:id="columnsContainer" spacing="8">
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <TextField promptText="Column name" text="To do"
                                   style="-fx-background-radius: 8; -fx-border-color: #ccc; -fx-border-radius: 8; -fx-padding: 6;"/>
                        <ColorPicker fx:id="colorPicker1" />
                    </HBox>
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <TextField promptText="Column name" text="Doing"
                                   style="-fx-background-radius: 8; -fx-border-color: #ccc; -fx-border-radius: 8; -fx-padding: 6;"/>
                        <ColorPicker fx:id="colorPicker2" />
                    </HBox>
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <TextField promptText="Column name" text="To review"
                                   style="-fx-background-radius: 8; -fx-border-color: #ccc; -fx-border-radius: 8; -fx-padding: 6;"/>
                        <ColorPicker fx:id="colorPicker3" />
                    </HBox>
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <TextField promptText="Column name" text="Done"
                                   style="-fx-background-radius: 8; -fx-border-color: #ccc; -fx-border-radius: 8; -fx-padding: 6;"/>
                        <ColorPicker fx:id="colorPicker4" />
                    </HBox>
                </VBox>

                <!-- Bouton d'ajout de colonne -->
                <Button fx:id="addColumnButton" text="+ Add column"
                        onAction="#handleAddColumn"
                        style="-fx-background-color: #eef4ff; -fx-text-fill: #3A56D0;
                               -fx-font-weight: bold; -fx-background-radius: 10;
                               -fx-padding: 6 16; -fx-border-color: #3A56D0; -fx-border-radius: 10;" />

                <Label text="Visibility *" style="-fx-font-weight: bold; -fx-font-size: 13px;" />
                <ChoiceBox fx:id="visibilityChoice" prefWidth="380"
                           style="-fx-background-radius: 8; -fx-border-color: #ccc; -fx-border-radius: 8; -fx-padding: 4;" />
            </VBox>

            <!-- Boutons -->
            <HBox spacing="15" alignment="CENTER_RIGHT" prefWidth="380">
                <Button fx:id="cancelButton" text="Cancel"
                        onAction="#handleCancel"
                        style="-fx-background-color: #f1f1f1; -fx-text-fill: #333; -fx-font-weight: bold; -fx-background-radius: 10; -fx-padding: 8 16;" />

                <Button fx:id="createButton" text="Create Kanban"
                        onAction="#handleCreate"
                        style="-fx-background-color: linear-gradient(to right, #6A11CB, #2575FC);
                               -fx-text-fill: white; -fx-font-weight: bold;
                               -fx-background-radius: 10; -fx-padding: 8 20;" />
            </HBox>
        </VBox>
    </VBox>
</AnchorPane>