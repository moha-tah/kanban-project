<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.paint.Color?>
<?import javafx.scene.text.*?>

<AnchorPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="client.ihmMain.controllers.CreateKanbanController"
            prefWidth="900" prefHeight="600"
            style="-fx-background-color: linear-gradient(to bottom right, #6A11CB, #2575FC);">

    <VBox spacing="20" alignment="CENTER" AnchorPane.topAnchor="0" AnchorPane.bottomAnchor="0"
          AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0">

        <VBox spacing="15" alignment="CENTER" prefWidth="400" prefHeight="500"
              style="-fx-background-color: white; -fx-background-radius: 20; -fx-padding: 30; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.15), 10, 0, 0, 4);">

            <VBox alignment="CENTER" spacing="5">
                <Label text="Create a new Kanban" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #333;" />
                <Label fx:id="stepLabel" text="Step 1 of 3" style="-fx-font-size: 12px; -fx-text-fill: #888;" />
                <ProgressBar fx:id="progressBar" progress="0.33" prefWidth="200" style="-fx-accent: #6A11CB;"/>
            </VBox>

            <Separator />

            <StackPane VBox.vgrow="ALWAYS">

                <VBox fx:id="step1Box" spacing="15" alignment="CENTER_LEFT">
                    <Label text="Let's start with the basics." style="-fx-font-size: 14px; -fx-text-fill: #555;" wrapText="true"/>

                    <VBox spacing="5">
                        <Label text="Project Name *" style="-fx-font-weight: bold; -fx-font-size: 13px;" />
                        <TextField fx:id="projectNameField" promptText="Ex: Marketing Sprint"
                                   style="-fx-background-radius: 8; -fx-border-color: #ccc; -fx-border-radius: 8; -fx-padding: 10;" />
                    </VBox>

                    <VBox spacing="5">
                        <Label text="Description" style="-fx-font-weight: bold; -fx-font-size: 13px;" />
                        <TextArea fx:id="descriptionField" promptText="What is this project about?"
                                  prefRowCount="4" wrapText="true"
                                  style="-fx-background-radius: 8; -fx-border-color: #ccc; -fx-border-radius: 8; -fx-padding: 5;" />
                    </VBox>
                </VBox>

                <VBox fx:id="step2Box" spacing="10" alignment="TOP_LEFT" visible="false">
                    <Label text="Define your workflow." style="-fx-font-size: 14px; -fx-text-fill: #555;"/>

                    <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent;" VBox.vgrow="ALWAYS">
                        <VBox fx:id="columnsContainer" spacing="8" style="-fx-padding: 5;">
                            <HBox spacing="10" alignment="CENTER_LEFT">
                                <TextField promptText="Column name" text="To do" HBox.hgrow="ALWAYS"
                                           style="-fx-background-radius: 8; -fx-border-color: #ccc; -fx-border-radius: 8; -fx-padding: 6;"/>
                                <ColorPicker fx:id="colorPicker1" style="-fx-color-label-visible: false;"/>
                            </HBox>
                            <HBox spacing="10" alignment="CENTER_LEFT">
                                <TextField promptText="Column name" text="Doing" HBox.hgrow="ALWAYS"
                                           style="-fx-background-radius: 8; -fx-border-color: #ccc; -fx-border-radius: 8; -fx-padding: 6;"/>
                                <ColorPicker fx:id="colorPicker2" style="-fx-color-label-visible: false;"/>
                            </HBox>
                            <HBox spacing="10" alignment="CENTER_LEFT">
                                <TextField promptText="Column name" text="To review" HBox.hgrow="ALWAYS"
                                           style="-fx-background-radius: 8; -fx-border-color: #ccc; -fx-border-radius: 8; -fx-padding: 6;"/>
                                <ColorPicker fx:id="colorPicker3" style="-fx-color-label-visible: false;"/>
                            </HBox>
                            <HBox spacing="10" alignment="CENTER_LEFT">
                                <TextField promptText="Column name" text="Done" HBox.hgrow="ALWAYS"
                                           style="-fx-background-radius: 8; -fx-border-color: #ccc; -fx-border-radius: 8; -fx-padding: 6;"/>
                                <ColorPicker fx:id="colorPicker4" style="-fx-color-label-visible: false;"/>
                            </HBox>
                        </VBox>
                    </ScrollPane>

                    <Button fx:id="addColumnButton" text="+ Add column"
                            onAction="#handleAddColumn"
                            maxWidth="Infinity"
                            style="-fx-background-color: #eef4ff; -fx-text-fill: #3A56D0; -fx-font-weight: bold; -fx-background-radius: 8; -fx-border-color: #3A56D0; -fx-border-radius: 8; -fx-border-style: dashed;" />
                </VBox>

                <VBox fx:id="step3Box" spacing="20" alignment="CENTER" visible="false">
                    <Label text="Who can see this project?" style="-fx-font-size: 14px; -fx-text-fill: #555;"/>

                    <VBox spacing="5" alignment="CENTER_LEFT" maxWidth="250">
                        <Label text="Visibility *" style="-fx-font-weight: bold; -fx-font-size: 13px;" />
                        <ChoiceBox fx:id="visibilityChoice" prefWidth="250"
                                   style="-fx-background-radius: 8; -fx-border-color: #ccc; -fx-border-radius: 8; -fx-padding: 5;" />
                    </VBox>

                    <HBox alignment="CENTER" spacing="8" style="-fx-background-color: #eef4ff; -fx-background-radius: 8; -fx-padding: 10;">
                        <Label text="Info:" style="-fx-font-weight: bold; -fx-text-fill: #3A56D0;"/>
                        <Label text="Public projects are accessible to everyone." wrapText="true" style="-fx-font-size: 12px;"/>
                    </HBox>
                </VBox>

            </StackPane>

            <Separator />

            <HBox spacing="15" alignment="CENTER_RIGHT" prefWidth="380">
                <Button fx:id="btnBack" text="Back"
                        onAction="#handleBack"
                        visible="false"
                        style="-fx-background-color: #f1f1f1; -fx-text-fill: #333; -fx-font-weight: bold; -fx-background-radius: 10; -fx-padding: 8 20;" />

                <Region HBox.hgrow="ALWAYS" />

                <Button fx:id="btnNext" text="Next"
                        onAction="#handleNext"
                        style="-fx-background-color: linear-gradient(to right, #6A11CB, #2575FC); -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 10; -fx-padding: 8 30;" />
            </HBox>
        </VBox>
    </VBox>
</AnchorPane>