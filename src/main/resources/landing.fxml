<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Rectangle?>

<BorderPane fx:id="root"
            xmlns:fx="http://javafx.com/fxml/1"
            xmlns="http://javafx.com/javafx/25"
            styleClass="landing-root"
            fx:controller="client.ihmMain.controllers.LandingPageController">

    <!-- HEADER -->
    <top>
        <HBox spacing="20" styleClass="header">
            <Button fx:id="logoButton" style="-fx-background-color: transparent; -fx-padding: 0;">
                <graphic>
                    <ImageView fitHeight="40" fitWidth="40">
                        <image><Image url="@k-logo-bg.png"/></image>
                    </ImageView>
                </graphic>
            </Button>

            <Region prefHeight="40.0" prefWidth="50.0"/>

            <HBox spacing="15" styleClass="nav">
                <Button onAction="#showFeatures" styleClass="nav-button" text="FEATURES"/>
                <Button onAction="#showAbout" styleClass="nav-button" text="ABOUT US"/>
                <Button onAction="#showContact" styleClass="nav-button" text="CONTACT US"/>
            </HBox>

            <Region HBox.hgrow="ALWAYS"/>

            <Button onAction="#login" styleClass="nav-button" text="LOGIN"/>
        </HBox>
    </top>

    <!-- CONTENU CENTRAL -->
    <center>
        <ScrollPane fx:id="scrollPane"
                    fitToWidth="true"
                    hbarPolicy="NEVER"
                    vbarPolicy="ALWAYS"
                    styleClass="scroll-pane">
            <content>
                <VBox spacing="40" style="-fx-padding: 40;">

                    <!-- Hero Section -->
                    <VBox spacing="20">
                        <Label styleClass="hero-title"
                               text="ORGANIZE YOUR WORK, VISUALIZE YOUR PROGRESS"/>
                        <Label styleClass="hero-subtitle"
                               text="Gain clarity, boost collaboration, and manage your projects effortlessly"/>
                    </VBox>

                    <!-- Kanban Cards -->
                    <HBox spacing="20" styleClass="cards-container">
                        <VBox spacing="10" styleClass="status-column status-pending">
                            <Label styleClass="status-header" text="Pending"/>
                            <VBox spacing="5" styleClass="task-card">
                                <Label styleClass="task-label" text="Product"/>
                                <Label styleClass="task-title" text="Name of the product"/>
                                <Label styleClass="task-label" text="Created on"/>
                                <Label styleClass="task-date" text="May 27, 2019 12:06 PM"/>
                                <Label styleClass="task-label" text="Priority"/>
                                <Label styleClass="task-priority priority-low" text="Low"/>
                                <Label styleClass="task-label" text="Owner"/>
                                <HBox spacing="5" styleClass="task-owner">
                                    <Rectangle arcHeight="20" arcWidth="20" height="35"
                                               styleClass="owner-avatar" width="35"/>
                                    <Label styleClass="owner-name" text="Jenny Wilson"/>
                                </HBox>
                            </VBox>
                        </VBox>

                        <VBox spacing="10" styleClass="status-column status-progress">
                            <Label styleClass="status-header" text="In Process"/>
                            <VBox spacing="5" styleClass="task-card">
                                <Label styleClass="task-label" text="Product"/>
                                <Label styleClass="task-title" text="Name of the product"/>
                                <Label styleClass="task-label" text="Created on"/>
                                <Label styleClass="task-date" text="May 27, 2019 12:06 PM"/>
                                <Label styleClass="task-label" text="Priority"/>
                                <Label styleClass="task-priority priority-critical" text="Critical"/>
                                <Label styleClass="task-label" text="Owner"/>
                                <HBox spacing="5" styleClass="task-owner">
                                    <Rectangle arcHeight="20" arcWidth="20" height="35"
                                               styleClass="owner-avatar" width="35"/>
                                    <Label styleClass="owner-name" text="Jenny Wilson"/>
                                </HBox>
                            </VBox>
                        </VBox>

                        <VBox spacing="10" styleClass="status-column status-hold">
                            <Label styleClass="status-header" text="On Hold"/>
                            <VBox spacing="5" styleClass="task-card">
                                <Label styleClass="task-label" text="Product"/>
                                <Label styleClass="task-title" text="Name of the product"/>
                                <Label styleClass="task-label" text="Created on"/>
                                <Label styleClass="task-date" text="May 27, 2019 12:06 PM"/>
                                <Label styleClass="task-label" text="Priority"/>
                                <Label styleClass="task-priority priority-medium" text="Medium"/>
                                <Label styleClass="task-label" text="Owner"/>
                                <HBox spacing="5" styleClass="task-owner">
                                    <Rectangle arcHeight="20" arcWidth="20" height="35"
                                               styleClass="owner-avatar" width="35"/>
                                    <Label styleClass="owner-name" text="Jenny Wilson"/>
                                </HBox>
                            </VBox>
                        </VBox>

                        <VBox spacing="10" styleClass="status-column status-finished">
                            <Label styleClass="status-header" text="Finished"/>
                            <VBox spacing="5" styleClass="task-card">
                                <Label styleClass="task-label" text="Product"/>
                                <Label styleClass="task-title" text="Name of the product"/>
                                <Label styleClass="task-label" text="Created on"/>
                                <Label styleClass="task-date" text="May 27, 2019 12:06 PM"/>
                                <Label styleClass="task-label" text="Priority"/>
                                <Label styleClass="task-priority priority-high" text="High"/>
                                <Label styleClass="task-label" text="Owner"/>
                                <HBox spacing="5" styleClass="task-owner">
                                    <Rectangle arcHeight="20" arcWidth="20" height="35"
                                               styleClass="owner-avatar" width="35"/>
                                    <Label styleClass="owner-name" text="Jenny Wilson"/>
                                </HBox>
                            </VBox>
                        </VBox>
                    </HBox>

                    <!-- Features Section -->
                    <VBox spacing="20" styleClass="features">
                        <Label styleClass="features-title" text="Key Features"/>
                        <HBox spacing="40" styleClass="features-grid">
                            <VBox spacing="10" styleClass="feature-item">
                                <Label styleClass="feature-icon" text="👥"/>
                                <Label styleClass="feature-title" text="Real-Time Collaboration"/>
                                <Label styleClass="feature-description" text="Work seamlessly with your team."/>
                            </VBox>
                            <VBox spacing="10" styleClass="feature-item">
                                <Label styleClass="feature-icon" text="👁️"/>
                                <Label styleClass="feature-title" text="Visual Project Tracking"/>
                                <Label styleClass="feature-description" text="Get an instant overview."/>
                            </VBox>
                            <VBox spacing="10" styleClass="feature-item">
                                <Label styleClass="feature-icon" text="📋"/>
                                <Label styleClass="feature-title" text="Flexible Customization"/>
                                <Label styleClass="feature-description" text="Adapt boards to your workflow."/>
                            </VBox>
                        </HBox>
                    </VBox>

                </VBox>
            </content>
        </ScrollPane>
    </center>

</BorderPane>