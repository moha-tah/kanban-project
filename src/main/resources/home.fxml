<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<AnchorPane prefHeight="720" prefWidth="1280"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="client.ihmMain.controllers.HomeViewController">

    <!-- ==== TOP BAR ==== -->
    <HBox fx:id="topBar" alignment="CENTER_LEFT" prefHeight="60" spacing="15"
          style="-fx-background-color: #E6DEE4; -fx-padding: 10; -fx-border-color: transparent transparent black transparent; -fx-border-width: 0 0 1 0;"
          AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">

        <ImageView fitHeight="35" fitWidth="35" preserveRatio="true">
            <image><Image url="@logo.png"/></image>
        </ImageView>

        <Region HBox.hgrow="ALWAYS" />

        <Button fx:id="logoutButton" text="Logout" onAction="#handleLogout"
                style="-fx-background-color: #ff99cc; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 15; -fx-padding: 5 15;" />

        <HBox alignment="CENTER_RIGHT" spacing="12">
                <Button fx:id="notifButton" text="🔔" onAction="#handleNotif" style="-fx-background-color: transparent; -fx-font-size: 18px;" />
                <Button fx:id="homeButton" text="🏠" onAction="#handleHome" style="-fx-background-color: transparent; -fx-font-size: 18px;" />
                <ImageView fx:id="profilePic" fitHeight="35" fitWidth="35" preserveRatio="true" onMouseClicked="#handleProfileClick">
                        <image><Image url="@profile_pic.png"/></image>
                </ImageView>
        </HBox>

    </HBox>

    <!-- ==== MAIN CONTENT ==== -->
    <HBox AnchorPane.topAnchor="60.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0">

        <!-- SIDEBAR -->
        <VBox fx:id="sidebar" prefWidth="220" spacing="15" alignment="TOP_CENTER"
              style="-fx-background-color: linear-gradient(to bottom, #1a1a1a, #4b006e); -fx-padding: 16;">
            <Label text="USERS" style="-fx-text-fill: white; -fx-font-size: 18px; -fx-font-weight: bold;" />
            <VBox fx:id="usersContainer" spacing="15" />
        </VBox>

        <!-- KANBAN AREA -->
        <ScrollPane fx:id="kanbanArea" fitToWidth="true" style="-fx-background-color: #E6DEE4;" HBox.hgrow="ALWAYS">
            <VBox fx:id="kanbanSections" spacing="30" style="-fx-padding: 20;">

                <!-- Search + Create -->
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <TextField fx:id="searchField" promptText="Search Kanbans..."
                               HBox.hgrow="ALWAYS"
                               style="-fx-background-color: white; -fx-border-color: #ccc; -fx-border-radius: 20; -fx-background-radius: 20; -fx-padding: 8 15; -fx-font-size: 14px;"/>
                    <Button fx:id="createKanbanButton" text="Create Kanban"         onAction="#handleCreateKanban"
                            style="-fx-background-color: #000; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 20; -fx-padding: 8 18;"/>
                </HBox>

                <!-- Sections dynamiques -->
                <VBox spacing="10">
                    <Label text="CREATED KANBANS ▼" style="-fx-font-size: 18px; -fx-font-weight: bold;" />
                    <ScrollPane hbarPolicy="AS_NEEDED" vbarPolicy="NEVER" fitToHeight="true"
                                style="-fx-background-color: transparent;">
                        <HBox fx:id="createdKanbansContainer" spacing="15" style="-fx-padding: 5;" />
                    </ScrollPane>
                </VBox>

                <VBox spacing="10">
                    <Label text="KANBANS I PARTICIPATE IN ▼" style="-fx-font-size: 18px; -fx-font-weight: bold;" />
                    <ScrollPane hbarPolicy="AS_NEEDED" vbarPolicy="NEVER" fitToHeight="true"
                                style="-fx-background-color: transparent;">
                        <HBox fx:id="participateKanbansContainer" spacing="15" style="-fx-padding: 5;" />
                    </ScrollPane>
                </VBox>

                <VBox spacing="10">
                    <Label text="KANBANS AVAILABLE ▼" style="-fx-font-size: 18px; -fx-font-weight: bold;" />
                    <ScrollPane hbarPolicy="AS_NEEDED" vbarPolicy="NEVER" fitToHeight="true"
                                style="-fx-background-color: transparent;">
                        <HBox fx:id="availableKanbansContainer" spacing="15" style="-fx-padding: 5;" />
                    </ScrollPane>
                </VBox>
            </VBox>
        </ScrollPane>
    </HBox>
</AnchorPane>
