
<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<AnchorPane
    prefHeight="720"
    prefWidth="1280"
    xmlns="http://javafx.com/javafx/25"
    xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="client.ihmMain.controllers.HomeKanbanCentralController">

    <!-- ==== MAIN CONTENT ==== -->
    <HBox
        AnchorPane.topAnchor="60.0"
        AnchorPane.bottomAnchor="0.0"
        AnchorPane.leftAnchor="0.0"
        AnchorPane.rightAnchor="0.0">

        
        <!-- Zone Kanban -->
        <ScrollPane fx:id="kanbanArea" fitToWidth="true" HBox.hgrow="ALWAYS" style="-fx-background-color: #E6DEE4;">
            <VBox fx:id="kanbanSections" spacing="30" style="-fx-padding: 20;">
                <!-- Search + Create -->
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <TextField fx:id="searchField" promptText="Search Kanbans..."
                        HBox.hgrow="ALWAYS"
                        style="-fx-background-color: white; -fx-border-color: #ccc; -fx-border-radius: 20; -fx-background-radius: 20; -fx-padding: 8 15; -fx-font-size: 14px;"/>
                    <Button fx:id="createKanbanButton" text="Create Kanban" onAction="#handleCreateKanban"
                        style="-fx-background-color: #000; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 20; -fx-padding: 8 18;"/>
                </HBox>

                <!-- Sections Kanban -->
                <VBox spacing="10">
                    <Label text="CREATED KANBANS ▼" style="-fx-font-size: 18px; -fx-font-weight: bold;" />
                    <ScrollPane hbarPolicy="AS_NEEDED" vbarPolicy="NEVER" fitToHeight="true" style="-fx-background-color: transparent;">
                        <HBox fx:id="createdKanbansContainer" spacing="15" style="-fx-padding: 5;" />
                    </ScrollPane>
                </VBox>

                <VBox spacing="10">
                    <Label text="KANBANS I PARTICIPATE IN ▼" style="-fx-font-size: 18px; -fx-font-weight: bold;" />
                    <ScrollPane hbarPolicy="AS_NEEDED" vbarPolicy="NEVER" fitToHeight="true" style="-fx-background-color: transparent;">
                        <HBox fx:id="participateKanbansContainer" spacing="15" style="-fx-padding: 5;" />
                    </ScrollPane>
                </VBox>

                <VBox spacing="10">
                    <Label text="KANBANS AVAILABLE ▼" style="-fx-font-size: 18px; -fx-font-weight: bold;" />
                    <ScrollPane hbarPolicy="AS_NEEDED" vbarPolicy="NEVER" fitToHeight="true" style="-fx-background-color: transparent;">
                        <HBox fx:id="availableKanbansContainer" spacing="15" style="-fx-padding: 5;" />
                    </ScrollPane>
                </VBox>
            </VBox>
        </ScrollPane>
    </HBox>

    <!-- Panneau de notifications -->
    <Pane fx:id="notifPanel"
        prefWidth="300" prefHeight="400"
        visible="false" mouseTransparent="true"
        style="-fx-background-color: white; -fx-border-color: #ccc; -fx-border-radius: 10; -fx-background-radius: 10; -fx-padding: 15;"
        AnchorPane.topAnchor="60" AnchorPane.rightAnchor="20">
        <VBox spacing="10">
            <Label text="Notifications" style="-fx-font-size: 18; -fx-font-weight: bold;"/>

            <ScrollPane fitToWidth="true" hbarPolicy="NEVER" style="-fx-background-color:transparent;">
                <VBox fx:id="notifContainer" spacing="10"/>
            </ScrollPane>
        </VBox>
    </Pane>
</AnchorPane>